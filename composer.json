{
    "name": "spryker/quote-approvals-rest-api",
    "type": "library",
    "description": "QuoteApprovalsRestApi module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker/carts-rest-api": "^5.25.0",
        "spryker/checkout-rest-api": "^3.0.0",
        "spryker/company-role": "^1.0.0",
        "spryker/kernel": "^3.30.0",
        "spryker/quote-approval": "^1.11.0",
        "spryker/symfony": "^3.0.0",
        "spryker/transfer": "^3.25.0"
    },
    "require-dev": {
        "spryker/api-platform": "^1.0.0",
        "spryker/code-sniffer": "*"
    },
    "suggest": {
        "spryker/api-platform": "If you want to expose the quote approval resources through the API Platform stack; they exist only there."
    },
    "autoload": {
        "psr-4": {
            "Spryker\\": "src/Spryker/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "conflict": {
        "spryker/api-platform": "<1.52.0"
    }
}
