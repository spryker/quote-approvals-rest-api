<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="Quote">
        <property name="uuid" type="string"/>
        <property name="customerReference" type="string"/>
        <property name="customer" type="Customer"/>
        <property name="quoteApprovals" type="QuoteApproval[]" singular="quoteApproval"/>
        <property name="quotePermissionGroup" type="QuotePermissionGroup"/>
        <property name="items" type="Item[]" singular="item"/>
    </transfer>

    <transfer name="Item">
    </transfer>

    <transfer name="QuoteResponse">
        <property name="quoteTransfer" type="Quote"/>
        <property name="isSuccessful" type="bool"/>
    </transfer>

    <transfer name="QuotePermissionGroup">
    </transfer>

    <transfer name="Customer">
        <property name="idCustomer" type="int"/>
        <property name="customerReference" type="string"/>
        <property name="firstName" type="string"/>
        <property name="lastName" type="string"/>
        <property name="companyUserTransfer" type="CompanyUser"/>
    </transfer>

    <transfer name="CompanyUser">
        <property name="idCompanyUser" type="int"/>
        <property name="uuid" type="string"/>
        <property name="fkCompany" type="int"/>
        <property name="fkCompanyBusinessUnit" type="int"/>
        <property name="customer" type="Customer"/>
        <property name="companyBusinessUnit" type="CompanyBusinessUnit"/>
    </transfer>

    <transfer name="CompanyBusinessUnit">
        <property name="name" type="string"/>
    </transfer>

    <transfer name="CompanyUserCollection">
        <property name="companyUsers" type="CompanyUser[]" singular="companyUser"/>
    </transfer>

    <transfer name="CompanyRoleCriteriaFilter">
        <property name="idCompanyUser" type="int"/>
    </transfer>

    <transfer name="CompanyRoleCollection">
        <property name="roles" type="CompanyRole[]" singular="role"/>
    </transfer>

    <transfer name="CompanyRole">
        <property name="permissionCollection" type="PermissionCollection"/>
    </transfer>

    <transfer name="PermissionCollection">
        <property name="permissions" type="Permission[]" singular="permission"/>
    </transfer>

    <transfer name="Permission">
        <property name="key" type="string"/>
    </transfer>

    <transfer name="QuoteApproval">
        <property name="idQuoteApproval" type="int"/>
        <property name="uuid" type="string"/>
        <property name="approver" type="CompanyUser"/>
        <property name="approverCompanyUserId" type="int"/>
        <property name="status" type="string"/>
        <property name="createdAt" type="string"/>
        <property name="updatedAt" type="string"/>
    </transfer>

    <transfer name="QuoteApprovalRequest">
        <property name="quote" type="Quote"/>
        <property name="approverCompanyUserId" type="int"/>
        <property name="requesterCompanyUserId" type="int"/>
        <property name="idQuoteApproval" type="int"/>
    </transfer>

    <transfer name="QuoteApprovalResponse">
        <property name="isSuccessful" type="bool"/>
        <property name="quote" type="Quote"/>
        <property name="messages" type="Message[]" singular="message"/>
    </transfer>

    <transfer name="Message">
        <property name="value" type="string"/>
    </transfer>

    <transfer name="RestCheckoutRequestAttributes">
        <property name="idCart" type="string"/>
        <property name="customer" type="RestCustomer"/>
        <property name="billingAddress" type="RestAddress" restRequestParameter="yes" description="The address used for billing purposes."/>
        <property name="shippingAddress" type="RestAddress" restRequestParameter="yes" description="The address where an order should be shipped."/>
        <property name="payments" type="RestPayment[]" singular="payment" restRequestParameter="yes" description="A collection of payments associated with an order."/>
        <property name="shipment" type="RestShipment" restRequestParameter="yes" description="The shipment details for an order."/>
    </transfer>

    <transfer name="RestAddress">
        <property name="id" type="string" restRequestParameter="yes"/>
        <property name="idCompanyBusinessUnitAddress" type="string"/>
        <property name="salutation" type="string" restRequestParameter="required" description="The salutation of a person (e.g., Mr., Mrs., Dr.)."/>
        <property name="firstName" type="string" restRequestParameter="required" description="The first name of a person."/>
        <property name="lastName" type="string" restRequestParameter="required" description="The last name of a user or customer."/>
        <property name="address1" type="string" restRequestParameter="required" description="The first line of a street address."/>
        <property name="address2" type="string" restRequestParameter="required" description="The second line of a street address."/>
        <property name="address3" type="string" restRequestParameter="required" description="The third line of a street address."/>
        <property name="zipCode" type="string" restRequestParameter="required" description="The postal code for an address."/>
        <property name="city" type="string" restRequestParameter="required" description="The city part of an address."/>
        <property name="iso2Code" type="string" restRequestParameter="required" description="The two-letter ISO code for a country."/>
        <property name="company" type="string" restRequestParameter="required" description="A company entity."/>
        <property name="phone" type="string" restRequestParameter="required" description="The phone number."/>
    </transfer>

    <transfer name="RestShipment">
        <property name="idShipmentMethod" type="int" restRequestParameter="yes"/>
    </transfer>

    <transfer name="RestPayment">
        <property name="paymentProviderName" type="string" restRequestParameter="required" description="The name of the payment provider."/>
        <property name="paymentMethodName" type="string" restRequestParameter="required" description="The name of the payment method."/>
    </transfer>

    <transfer name="RestCustomer">
        <property name="idCustomer" type="int"/>
        <property name="customerReference" type="string"/>
        <property name="idCompanyUser" type="int"/>
        <property name="idCompany" type="int"/>
        <property name="idCompanyBusinessUnit" type="int"/>
        <property name="companyUserTransfer" type="CompanyUser"/>
    </transfer>

    <transfer name="RestCheckoutDataResponse">
        <property name="isSuccess" type="bool"/>
        <property name="checkoutData" type="RestCheckoutData"/>
        <property name="errors" type="RestCheckoutError[]" singular="error"/>
    </transfer>

    <transfer name="RestCheckoutData">
        <property name="quote" type="Quote"/>
    </transfer>

    <transfer name="RestCheckoutError">
        <property name="detail" type="string"/>
    </transfer>

    <transfer name="RestErrorMessage">
        <property name="code" type="string"/>
        <property name="status" type="int"/>
        <property name="detail" type="string"/>
    </transfer>

</transfers>
